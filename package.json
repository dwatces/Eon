    "@vitest/coverage-v8": "5.0.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "globals": "16.4.0",
    "jsdom": "30.1.2",
    "node-mocks-http": "1.18.1",
