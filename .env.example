# Copy to .env.local for local development. Every variable is optional:
# with none set, the shop runs in demo mode and the build needs nothing.

# Stripe secret key. Leave empty for demo mode (checkout shows an order
# summary and takes no payment). A test key (sk_test_ or rk_test_) hands
# off to Stripe Checkout in test mode. Any other key stays in demo mode
# unless EON_ALLOW_LIVE_PAYMENTS is "true".
STRIPE_SECRET_KEY=

# Set to "true" only to take real payments with a live Stripe key.
EON_ALLOW_LIVE_PAYMENTS=

# Accepted for older deployments but no longer used: checkout redirects
# to the URL Stripe returns, so the browser needs no Stripe key.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Public site URL for canonical links and Stripe return URLs, for example
# https://eon-ht82.vercel.app. Falls back to Vercel's production URL, then
# to https://eon-ht82.vercel.app.
NEXT_PUBLIC_SITE_URL=

# Test only: send Stripe API calls to a local stub, for example
# http://127.0.0.1:7309. Ignored unless the host is localhost or 127.0.0.1.
EON_STRIPE_API_BASE=
